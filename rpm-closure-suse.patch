 my %provides;
+# A capability several packages provide resolves to the sorted-last
+# one, exactly as upstream -- except when the providers cannot
+# coexist. SUSE marks alternative system releases
+# `otherproviders()`: at most one may install, so the caller's own
+# top-level choice must win over the alphabetical accident
+# (measured: `aaa_base` needs `distribution-release`, which both
+# `openSUSE-release` and `unified-installer-release` provide;
+# installing both fails on /etc/os-release). Capabilities without
+# that marker resolve byte-identically to upstream.
+my %toplevel = map { $_ => 1 } @toplevelPkgs;
+my %otherprovidersOf;
+foreach my $pkgName (keys %pkgs) {
+    my $conflicts = $pkgs{$pkgName}->{format}->{'rpm:conflicts'}->{'rpm:entry'} // [];
+    foreach my $conflict (@{$conflicts}) {
+        if ($conflict->{name} =~ /^otherproviders\((.*)\)$/) {
+            $otherprovidersOf{$pkgName}{$1} = 1;
+        }
+    }
+}
+sub exclusive {
+    my ($cap, $a, $b) = @_;
+    return $otherprovidersOf{$a}{$cap} || $otherprovidersOf{$b}{$cap};
+}
+sub prefer {
+    my ($cap, $have, $want) = @_;
+    return 1 if !defined $have;
+    return 1 if !exclusive($cap, $have, $want);
+    return 1 if $toplevel{$want} && !$toplevel{$have};
+    return 0 if $toplevel{$have} && !$toplevel{$want};
+    return 1;
+}
