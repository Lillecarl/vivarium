 my %provides;
+# A capability with several providers resolves to a top-level package
+# when one names it, and to sorted-last otherwise: SUSE marks
+# alternative system releases with `otherproviders()`, meaning at
+# most one may install, and the caller's own choice must win over the
+# alphabetical accident (measured: `aaa_base` needs
+# `distribution-release`, which both `openSUSE-release` and
+# `unified-installer-release` provide; installing both fails on
+# /etc/os-release).
+my %toplevel = map { $_ => 1 } @toplevelPkgs;
+sub prefer {
+    my ($have, $want) = @_;
+    return 1 if !defined $have;
+    return 1 if $toplevel{$want} && !$toplevel{$have};
+    return 0;
+}
